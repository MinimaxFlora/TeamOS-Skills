{
 "_meta": {
  "name": "patterns_en",
  "source": "Wikipedia:Signs of AI writing (2026-08 版) + 2026 公开写作研究",
  "notes": "词表命中仅代表统计倾向；term_guards 保护正当学术用法。weight=每个命中的分值。"
 },
 "model_artifacts": [
  {
   "pattern": "oaicite",
   "desc": "ChatGPT citation residue"
  },
  {
   "pattern": "turn0search[0-9]+",
   "desc": "ChatGPT search-citation residue"
  },
  {
   "pattern": "contentreference",
   "desc": "ChatGPT citation residue"
  },
  {
   "pattern": "\\[cite:\\s*[0-9,\\s-]+\\]",
   "desc": "Gemini citation residue"
  },
  {
   "pattern": "\\[span_[0-9]+\\]\\(start_span\\)",
   "desc": "Gemini span residue"
  },
  {
   "pattern": "grok[_-]?card",
   "desc": "Grok card residue"
  },
  {
   "pattern": "attached_file[_0-9]*",
   "desc": "Perplexity attachment residue"
  },
  {
   "pattern": ":::writing[\\s\\S]{0,200}?:::",
   "desc": "unclassified writing fence"
  },
  {
   "pattern": "\\[INST\\]|<\\|im_start\\|>|<\\|end_of\\|>",
   "desc": "template marker leak"
  }
 ],
 "chatbot_artifacts": [
  {
   "pattern": "(as an ai( language model)?|as a (large )?language model|i('?m| am) an ai( language model)?)\\s*,?\\s*(i|my|we)\\s+(am|was|cannot|can'?t|could ?n'?t|do ?n'?t|lack|apologize|have)",
   "desc": "AI self-declaration (self-referential)"
  },
  {
   "pattern": "\\bhope (this|that) helps\\b",
   "desc": "客服式收尾（无主语变体）"
  },
  {
   "pattern": "i (hope this|hope that) helps",
   "desc": "客服式收尾"
  },
  {
   "pattern": "great question",
   "desc": "客套开场"
  },
  {
   "pattern": "certainly[!,] here (is|are)",
   "desc": "顺从式开场"
  },
  {
   "pattern": "of course[!,] here (is|are)",
   "desc": "顺从式开场"
  },
  {
   "pattern": "here (is|are) the (revised|rewritten|rephrased|improved) (version|text|essay|paragraph)",
   "desc": "交付式开场"
  },
  {
   "pattern": "let me know if you (need|want|have)",
   "desc": "客服式收尾"
  },
  {
   "pattern": "feel free to (modify|adjust|reach out)",
   "desc": "客服式收尾"
  },
  {
   "pattern": "i cannot fulfill|against my (guidelines|programming)",
   "desc": "拒答残留"
  }
 ],
 "knowledge_cutoff": [
  {
   "pattern": "as of my last (knowledge )?(update|training)",
   "desc": "知识截止"
  },
  {
   "pattern": "(my|our) knowledge cutoff",
   "desc": "知识截止"
  },
  {
   "pattern": "up until (my|the) (knowledge cutoff|last update)",
   "desc": "知识截止"
  },
  {
   "pattern": "i don't have (access to|information about|real-?time)",
   "desc": "能力声明"
  }
 ],
